<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.0/css/all.min.css" integrity="sha512-ApSLB1Pd3/bZN8fWB/RG9YhN/7bd9Hkf3AGaE2mPfebjrxagjuBtx2GcgdqIlJkUzwylBo61r9Xa9NmgBI0swA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="./css/tasks.css">
    <title>To Do App</title>
</head>
<body>
    <nav>
        <h1>TO DO APP</h1>
        <div class="profile-container">
            <div><%=  %></div>
            <div>
                <label for="toggle-profile-menu" class="hamburger"><i class="fa-solid fa-user"></i></label>
                <input type="checkbox" id="toggle-profile-menu" hidden>
            </div>
        </div>
    </nav>
    <main>
        <table id="task-table">
            <thead>
                <tr>
                    <th class="col-num">S.No.</th>
                    <th class="col-task">Added Tasks</th>
                    <th class="col-status">Status</th>
                    <th class="col-delete">Delete</th>
                </tr>
            </thead>
            <tbody id="task-lists">
                <tr class="task-info">
                    <td class="col-num">S.No.</td>
                    <td class="col-task">Apple</td>
                    <td class="col-status"><button type="button" class="status-btn yellow">Incomplete</button></td>
                    <td class="col-delete"><button type="button" class="del-btn">Delete</button></td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="add-btn"><i class="fa-solid fa-arrow-right"></i>Add a new Task<i class="fa-solid fa-arrow-left"></i></td>
                </tr>
            </tfoot>
        </table>
    </main>
    <script src="./js/tasks.js"></script>
</body>
</html>